#!/bin/bash
set -e

case "$1" in
    configure)
        echo "Setting up MS SSO OpenConnect VPN plugin..."

        echo "Checking Playwright driver..."
        if ! python3 -c 'from playwright.sync_api import sync_playwright; p = sync_playwright().start(); p.stop()' 2>/dev/null; then
            echo "Installing a coherent Playwright Python/Node runtime..."
            # Ubuntu's Python package can exist without its matching Node
            # driver. Overlay a complete upstream runtime without trying to
            # uninstall distro-owned files.
            pip3 install --break-system-packages --ignore-installed 'playwright>=1.55,<2' || \
            pip3 install --ignore-installed 'playwright>=1.55,<2' || {
                echo "ERROR: Could not install the Playwright runtime."
                exit 1
            }
        fi

        # Avoid nested apt from dpkg. Reuse either the package-owned cache or a
        # compatible legacy cache, and only download Chromium when both fail.
        if env PLAYWRIGHT_BROWSERS_PATH=/var/cache/ms-playwright \
            python3 -c 'from playwright.sync_api import sync_playwright; p = sync_playwright().start(); b = p.chromium.launch(headless=True, args=["--no-sandbox"]); b.close(); p.stop()' 2>/dev/null || \
            python3 -c 'from playwright.sync_api import sync_playwright; p = sync_playwright().start(); b = p.chromium.launch(headless=True, args=["--no-sandbox"]); b.close(); p.stop()' 2>/dev/null; then
            echo "Playwright Chromium runtime already installed."
        else
            echo "Installing Chromium runtime for Playwright..."
            mkdir -p /var/cache/ms-playwright
            PLAYWRIGHT_BROWSERS_PATH=/var/cache/ms-playwright \
                python3 -m playwright install chromium || {
                    echo "ERROR: Could not install Chromium for Playwright."
                    echo "Please run manually: sudo PLAYWRIGHT_BROWSERS_PATH=/var/cache/ms-playwright python3 -m playwright install chromium"
                    exit 1
                }
            if ! env PLAYWRIGHT_BROWSERS_PATH=/var/cache/ms-playwright \
                python3 -c 'from playwright.sync_api import sync_playwright; p = sync_playwright().start(); b = p.chromium.launch(headless=True, args=["--no-sandbox"]); b.close(); p.stop()' 2>/dev/null; then
                echo "ERROR: Chromium was installed but cannot start; required system libraries may be missing."
                exit 1
            fi
            echo "Chromium runtime installed successfully."
        fi

        # D-Bus-activated helpers can survive a NetworkManager restart and
        # continue running the pre-upgrade code. Stop them explicitly so the
        # next activation always starts the helper installed by this package.
        pkill -f /usr/libexec/nm-ms-sso-service >/dev/null 2>&1 || true

        # Restart NetworkManager to pick up the new plugin
        if systemctl is-active --quiet NetworkManager; then
            echo "Restarting NetworkManager..."
            systemctl restart NetworkManager || true
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        ;;
esac

#DEBHELPER#

exit 0
